        { "id": "room.desc_charisma", "en": "[Charisma] increases the influential power\\nof your comments, making others more\\nlikely to agree and follow your lead.", "box": [1058, 0, 439, 96], "ink": [1062, 1, 1497, 82], "manual": true, "size": 21.5, "baseline": 20, "erase": "clear", "wrap": true, "align": "left", "lineHeight": 27.5, "color": "#ffffff", "accent": "#f5d300" },
        { "id": "room.desc_intuition", "en": "[Intuition] allows you to pick up on other\\npeople' s lies and suspicious behavior.", "box": [1058, 100, 439, 74], "ink": [1062, 104, 1497, 162], "manual": true, "size": 21.5, "baseline": 125, "erase": "clear", "wrap": true, "align": "left", "lineHeight": 27.5, "color": "#ffffff", "accent": "#f5d300" },
        { "id": "room.desc_logic", "en": "[Logic] makes it easier for you to convince\\nothers that you' re right.", "box": [1058, 178, 439, 72], "ink": [1062, 182, 1497, 239], "manual": true, "size": 21.5, "baseline": 204, "erase": "clear", "wrap": true, "align": "left", "lineHeight": 27.5, "color": "#ffffff", "accent": "#f5d300" },
        { "id": "room.desc_charm", "en": "[Charm] makes you more amicable, and thus\\nless likely to be selected for cold sleep.", "box": [1058, 255, 439, 75], "ink": [1062, 259, 1497, 318], "manual": true, "size": 21.5, "baseline": 282, "erase": "clear", "wrap": true, "align": "left", "lineHeight": 27.5, "color": "#ffffff", "accent": "#f5d300" },
        { "id": "room.desc_performance", "en": "[Performance] makes you a better liar,\\nand helps you to more efficiently\\nget your point across.", "box": [1058, 335, 439, 101], "ink": [1062, 339, 1497, 426], "manual": true, "size": 21.5, "baseline": 360, "erase": "clear", "wrap": true, "align": "left", "lineHeight": 27.5, "color": "#ffffff", "accent": "#f5d300" },
        { "id": "room.desc_stealth", "en": "[Stealth] makes it harder for others\\nto pick up on your malicious\\nintent, and makes the Gnosia\\nless likely to target you.", "box": [1058, 440, 439, 125], "ink": [1062, 445, 1497, 559], "wrapWidth": 318, "manual": true, "size": 21.5, "baseline": 467, "erase": "clear", "wrap": true, "align": "left", "lineHeight": 27.5, "color": "#ffffff", "accent": "#f5d300" }
      ]
    },
