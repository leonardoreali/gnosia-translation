    {
      "bundle": "systm_en",
      "textures": ["setup_KB", "setup_GP"],
      "items": [
        { "id": "setup.title", "en": "Setup", "box": [72, 60, 208, 80], "ink": [146, 92, 268, 140], "cut": 18 },
        { "id": "setup.gnosia", "en": "[Gnosia] are enemies of humans.\\nDuring warp, they will choose a\\ntarget and eliminate the humans\\none by one. They can falsely pose\\nas [Engineers] and [Doctors].", "box": [726, 0, 352, 215], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 31.25, "color": "#505050", "accent": "#f39800", "size": 26.8, "baseline": 21 },
        { "id": "setup.ac", "en": "[AC Followers] are humans, but they\\nwill lie and try to help the Gnosia\\nwin. They, too, can falsely pose as\\n[Engineers] and [Doctors].", "box": [726, 220, 352, 185], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 31.25, "color": "#505050", "accent": "#f39800", "size": 26.8 },
        { "id": "setup.guards", "en": "[Guards] (those on Guard Duty) can\\nannounce their status together,\\nproving that one another are human.\\nOthers cannot pose as [Guards].", "box": [726, 407, 352, 150], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 31.25, "color": "#505050", "accent": "#f39800", "size": 26.8 },
        { "id": "setup.bugs", "en": "[Bugs] are enemies of both humans\\nand Gnosia. They will not disappear\\nwhen attacked, but they will\\ndisappear when investigated by an\\nEngineer. They, too, can falsely pose\\nas [Engineers] and [Doctors].", "box": [407, 660, 354, 264], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 31.2, "color": "#505050", "accent": "#f39800", "size": 26.8 },
        { "id": "setup.engineers", "en": "[Engineers] are able to investigate\\nduring warp and discern whether or\\nnot a target is Gnosia.", "box": [762, 656, 362, 108], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 30, "color": "#505050", "accent": "#f39800", "size": 26.8 },
        { "id": "setup.angels", "en": "[Guardian Angels] can select one\\nperson to protect from Gnosia\\nattack during warp.", "box": [762, 764, 362, 108], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 29.5, "color": "#505050", "accent": "#f39800", "size": 26.8 },
        { "id": "setup.doctors", "en": "[Doctors] can discern whether or not\\na person put into cold sleep was\\nGnosia.", "box": [762, 870, 362, 138], "erase": "clear", "wrap": true, "align": "left", "lineHeight": 31.5, "color": "#505050", "accent": "#f39800", "size": 26.8 }
      ]
    },
